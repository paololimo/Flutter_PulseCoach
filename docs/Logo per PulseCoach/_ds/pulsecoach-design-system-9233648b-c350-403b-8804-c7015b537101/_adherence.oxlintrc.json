{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/catalog/**",
              "components/core/**",
              "components/feedback/**",
              "components/session/**",
              "components/social/**",
              "components/today/**",
              "ui_kits/pulsecoach_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityFeedCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:handle|sessionType|durationMinutes|relativeTime|isOwn|reacted|onReact|onRevoke|style|key|ref|className|style|children)$/]",
        "message": "<ActivityFeedCard> doesn't accept that prop. Declared props: handle, sessionType, durationMinutes, relativeTime, isOwn, reacted, onReact, onRevoke, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|variant|dot|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, variant, dot, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|secondary|tertiary|coral|neutral|error)$/]",
        "message": "<Badge> tone must be one of 'primary' | 'secondary' | 'tertiary' | 'coral' | 'neutral' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|solid)$/]",
        "message": "<Badge> variant must be one of 'soft' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|fullWidth|disabled|leadingIcon|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, fullWidth, disabled, leadingIcon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|tonal|text|danger)$/]",
        "message": "<Button> variant must be one of 'filled' | 'tonal' | 'text' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|accent|interactive|selected|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, variant, accent, interactive, selected, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:container|high|hero)$/]",
        "message": "<Card> variant must be one of 'container' | 'high' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selectable|selected|pill|tone|leadingDot|leadingIcon|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, selectable, selected, pill, tone, leadingDot, leadingIcon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|primary|secondary|tertiary|coral)$/]",
        "message": "<Chip> tone must be one of 'default' | 'primary' | 'secondary' | 'tertiary' | 'coral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompactSessionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:sessionType|title|durationMinutes|selected|onTap|style|key|ref|className|style|children)$/]",
        "message": "<CompactSessionCard> doesn't accept that prop. Declared props: sessionType, title, durationMinutes, selected, onTap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:handle|sessionsThisWeek|minutesThisWeek|weeklyTarget|isOwn|style|key|ref|className|style|children)$/]",
        "message": "<ComparisonRow> doesn't accept that prop. Declared props: handle, sessionsThisWeek, minutesThisWeek, weeklyTarget, isOwn, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompletedSessionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|durationMinutes|style|key|ref|className|style|children)$/]",
        "message": "<CompletedSessionCard> doesn't accept that prop. Declared props: title, durationMinutes, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompletionRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:completed|total|size|style|key|ref|className|style|children)$/]",
        "message": "<CompletionRing> doesn't accept that prop. Declared props: completed, total, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountdownOverlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:sessionTitle|onComplete|autoStart|style|key|ref|className|style|children)$/]",
        "message": "<CountdownOverlay> doesn't accept that prop. Declared props: sessionTitle, onComplete, autoStart, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FriendRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:handle|variant|requestSent|onPrimary|onSecondary|style|key|ref|className|style|children)$/]",
        "message": "<FriendRow> doesn't accept that prop. Declared props: handle, variant, requestSent, onPrimary, onSecondary, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroSessionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:sessionType|title|durationMinutes|intensity|location|explanation|onStart|onRegenerate|startLabel|style|key|ref|className|style|children)$/]",
        "message": "<HeroSessionCard> doesn't accept that prop. Declared props: sessionType, title, durationMinutes, intensity, location, explanation, onStart, onRegenerate, startLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='JoinCodeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:joinCode|onRefresh|size|style|key|ref|className|style|children)$/]",
        "message": "<JoinCodeCard> doesn't accept that prop. Declared props: joinCode, onRefresh, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LeaderboardRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:rank|handle|points|isOwn|style|key|ref|className|style|children)$/]",
        "message": "<LeaderboardRow> doesn't accept that prop. Declared props: rank, handle, points, isOwn, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProUpsellSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|detail|onDiscover|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<ProUpsellSheet> doesn't accept that prop. Declared props: message, detail, onDiscover, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RPEInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<RPEInput> doesn't accept that prop. Declared props: value, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionCatalogCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|category|difficulty|durationMinutes|onTap|style|key|ref|className|style|children)$/]",
        "message": "<SessionCatalogCard> doesn't accept that prop. Declared props: name, category, difficulty, durationMinutes, onTap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionCatalogCard'] > JSXAttribute[name.name='difficulty'] > Literal[value!=/^(?:low|medium|high)$/]",
        "message": "<SessionCatalogCard> difficulty must be one of 'low' | 'medium' | 'high'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionHistoryTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:sessionType|date|durationMinutes|rpe|abandoned|style|key|ref|className|style|children)$/]",
        "message": "<SessionHistoryTile> doesn't accept that prop. Declared props: sessionType, date, durationMinutes, rpe, abandoned, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShimmerPlaceholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|width|borderRadius|style|key|ref|className|style|children)$/]",
        "message": "<ShimmerPlaceholder> doesn't accept that prop. Declared props: height, width, borderRadius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignInSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|onApple|onGoogle|onEmail|onSkip|style|key|ref|className|style|children)$/]",
        "message": "<SignInSheet> doesn't accept that prop. Declared props: title, subtitle, onApple, onGoogle, onEmail, onSkip, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|message|style|key|ref|className|style|children)$/]",
        "message": "<StateIndicator> doesn't accept that prop. Declared props: state, label, message, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VisibilityOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<VisibilityOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeeklyGoalIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:completedThisWeek|weeklyTarget|style|key|ref|className|style|children)$/]",
        "message": "<WeeklyGoalIndicator> doesn't accept that prop. Declared props: completedThisWeek, weeklyTarget, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
