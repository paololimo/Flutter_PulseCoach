+
+  const tProfile = UserProfile(
+    fitnessLevel: 'medium',
+    goal: 'cardio',
+    availableTime: 'short',
+    physicalConstraints: 'none',
+  );
+
+  final tStateVector = StateVector(
+    restingHR: 65.0,
+    stepCount: 4000,
+    activityLevel: null,
+    rpeHistory: const [],
+    missedSessions: 7,
+    streak: 0,
+    aqiLevel: AqiLevel.low,
+    temperature: null,
+    precipitation: null,
+    userProfile: tProfile,
+    currentState: BehavioralState.active,
+  );
+
+  final tPlan = domain.DailyPlan(
+    planDate: _todayDate(),
+    sessions: const [
+      PlannedSession(
+        sessionType: 'cardio',
+        intensity: 6,
+        durationMinutes: 10,
+        isIndoor: false,
+      ),
+    ],
+    generatedAt: DateTime.now().toUtc(),
+  );
+
+  final tOutput = AiEngineOutput(
+    plan: tPlan,
