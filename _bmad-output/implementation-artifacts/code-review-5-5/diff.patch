+          PlannedSession(
+            sessionType: 'cardio',
+            intensity: 8,
+            durationMinutes: 20,
+            isIndoor: false,
+            explanation: '',
+          ),
+          PlannedSession(
+            sessionType: 'breathing',
+            intensity: 1,
+            durationMinutes: 5,
+            isIndoor: true,
+            explanation: '',
+          ),
+        ],
+        generatedAt: DateTime.utc(2026, 4, 29, 10, 30, 0),
