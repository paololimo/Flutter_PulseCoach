+    when(mockSensorRepo.fetchActivityLevel())
+        .thenAnswer((_) async => const Left(SensorFailure('unavailable')));
+    when(mockWeatherRepo.getWeatherContext())
+        .thenAnswer((_) async => const Left(ServerFailure('unavailable')));
