+    test('5.5-UNIT-023: savePlan twice for same date → second replaces first (no UniqueConstraintException)', () async {
+      final plan1 = domain.DailyPlan(
+        planDate: '2026-04-29',
+        sessions: const [
+          PlannedSession(
+            sessionType: 'cardio',
+            intensity: 6,
